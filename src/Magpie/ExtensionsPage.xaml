<Page x:Class="Magpie.ExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Magpie"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">
	<local:PageFrame x:Uid="Home_ExtensionsFrame">
		<Grid Padding="0,4,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<local:SimpleStackPanel Grid.Row="0"
			                        Orientation="Horizontal"
			                        Spacing="8">
				<Button Click="{x:Bind ViewModel.ImportExtension}"
				        Style="{StaticResource AccentButtonStyle}">
					<local:SimpleStackPanel Orientation="Horizontal"
					                        Spacing="8">
						<FontIcon Glyph="&#xE710;"
						          Style="{StaticResource ButtonFontIconStyle}" />
						<TextBlock Text="导入" />
					</local:SimpleStackPanel>
				</Button>
				<Button>
					<local:SimpleStackPanel Orientation="Horizontal"
					                        Spacing="8">
						<FontIcon Glyph="&#xF000;"
						          Style="{StaticResource ButtonFontIconStyle}" />
						<TextBlock Text="导入着色器效果" />
					</local:SimpleStackPanel>
				</Button>
			</local:SimpleStackPanel>
			<local:SimpleStackPanel Grid.Row="1"
			                        Margin="0,12,0,0"
			                        HorizontalAlignment="Center"
			                        VerticalAlignment="Center"
			                        Spacing="16"
			                        Visibility="{x:Bind ViewModel.HasExtension, Mode=OneWay, Converter={StaticResource NegativeVisibilityConverter}}">
				<FontIcon FontSize="80"
				          Glyph="&#xEA86;" />
				<TextBlock HorizontalAlignment="Center"
				           Text="尚未安装扩展"
				           TextWrapping="WrapWholeWords" />
			</local:SimpleStackPanel>
			<ListView Grid.Row="1"
			          Margin="0,12,0,0"
			          ItemsSource="{x:Bind ViewModel.Extensions, Mode=OneTime}"
			          SelectionMode="None"
			          TabNavigation="Local"
			          Visibility="{x:Bind ViewModel.HasExtension, Mode=OneWay}">
				<ListView.ItemContainerTransitions>
					<TransitionCollection>
						<ContentThemeTransition />
						<RepositionThemeTransition IsStaggeringEnabled="False" />
					</TransitionCollection>
				</ListView.ItemContainerTransitions>
				<ListView.Resources>
					<Style TargetType="ListViewItem">
						<Setter Property="Margin" Value="0,0,0,2" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="MinHeight" Value="0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="IsTabStop" Value="False" />
					</Style>
				</ListView.Resources>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:ExtensionItem">
						<local:SettingsExpander Description="{x:Bind Description, Mode=OneTime}"
						                        Header="{x:Bind Name, Mode=OneTime}">
							<ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
						</local:SettingsExpander>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>
	</local:PageFrame>
</Page>
