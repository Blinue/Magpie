namespace Magpie {
	runtimeclass ExtensionItem : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		String Name { get; };
		String Description { get; };
		Boolean IsEnabled;
		InfoGridData InfoData { get; };
		void Remove();
	}

	runtimeclass ExtensionsViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		void ImportExtension();
		Boolean HasExtension { get; };
		IVector<IInspectable> Extensions { get; };
	}
}
